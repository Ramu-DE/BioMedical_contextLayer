# Copy to .env and fill in. .env is gitignored — never commit it.
#   cp .env.example .env && chmod 600 .env
#
# Values are read through config.py, which never prints secrets: `python config.py`
# emits a readiness report showing only an 8-character fingerprint per secret.

# ── Neo4j: knowledge graph, term index, runtime context ───────────────────────
# Aura: neo4j+s://<id>.databases.neo4j.io    Self-hosted: bolt://host:7687
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Some Aura instances name the single user database after the instance id rather
# than "neo4j". Run scripts/verify_neo4j.py — it detects and reports the correct
# values for both of these.
NEO4J_KG_DATABASE=neo4j
NEO4J_CTX_DATABASE=neo4j
# Runtime context is isolated by label prefix when multi-database is unavailable
# (Aura Free/Pro). config.check() refuses to start if neither isolation
# mechanism is in place.
CTX_LABEL_PREFIX=Ctx_

# Neo4j-native vector and full-text indexes (5.11+ required for vectors)
NEO4J_TERM_INDEX=ctx_term_embedding
NEO4J_CHUNK_INDEX=ctx_chunk_embedding
NEO4J_FULLTEXT_INDEX=ctx_chunk_fulltext
VECTOR_SIMILARITY=cosine

# ── Vector store: neo4j | qdrant | opensearch ────────────────────────────────
VECTOR_BACKEND=qdrant

# Qdrant (used when VECTOR_BACKEND=qdrant)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=ctx_gov_chunks
QDRANT_TIMEOUT=30

# OpenSearch (used when VECTOR_BACKEND=opensearch)
OPENSEARCH_URL=
OPENSEARCH_AUTH=basic
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_CHUNK_INDEX=biomed_chunks
OPENSEARCH_TERM_INDEX=biomed_ontology_terms
OPENSEARCH_KNN_M=16
OPENSEARCH_KNN_EF_CONSTRUCTION=128

# ── Embeddings ───────────────────────────────────────────────────────────────
# bedrock | openai | huggingface_local
EMBEDDING_PROVIDER=bedrock
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
AWS_REGION=us-west-2
# Named profile from ~/.aws/credentials. Leave blank to use the default chain
# (instance role, environment, SSO).
AWS_PROFILE=
LLM_API_KEY=

# ── Governance ───────────────────────────────────────────────────────────────
# Refuse rather than answer below this grounding confidence. Raising it reduces
# confabulation and increases false refusals; 0.60 was chosen deliberately.
MIN_GROUNDING_CONFIDENCE=0.6
# Block requests for individual treatment guidance. Clinical decision support is
# regulated and out of scope for this reference implementation.
CLINICAL_ADVICE_GUARD=true

# ── Context assembly ─────────────────────────────────────────────────────────
# Entity linking: below this k-NN score a mention is emitted as "unlinked"
# rather than bound to a low-confidence concept.
ENTITY_LINK_THRESHOLD=0.72
CONTEXT_TOKEN_BUDGET=8000
PRIOR_DECISION_K=5
